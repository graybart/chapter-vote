# Postgres connection string.
# Vercel: use Neon / Vercel Postgres connection string (pooled).
# Docker: matches docker-compose.yml defaults.
DATABASE_URL=postgres://chaptervote:chaptervote@localhost:5432/chaptervote

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=changeme

# Canonical URL of the app (used for QR codes and Auth.js callbacks).
# Vercel: https://your-app.vercel.app  |  Self-hosted: https://vote.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Bootstrap admin (used by `npm run seed:admin`)
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=changeme
SEED_ADMIN_NAME=Chapter Admin
